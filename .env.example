# Copy to .env and adjust. Never commit .env.

# Host ports (dev)
FRONTEND_PORT=5180
BACKEND_PORT=8010
# Host port of the production profile (docker-compose.prod.yml)
APP_PORT=8088

# Database
POSTGRES_DB=chacao
POSTGRES_USER=chacao
POSTGRES_PASSWORD=change-me

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
# Add the server's LAN IP or hostname so phones on the gym network can connect.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# For the production profile, also list the full origin, e.g. http://192.168.0.10:8088
DJANGO_CSRF_TRUSTED_ORIGINS=
TZ=America/Sao_Paulo

# Initial admin account, created on first boot if it does not exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
