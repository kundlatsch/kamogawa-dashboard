# Production settings for docker-compose.prod.yml on the home server.
# Copy to `.env` next to docker-compose.prod.yml and replace every `change-me`.
# Never commit the real file: it holds the server's secrets.
#
# Generate random values with, for example:
#   openssl rand -base64 48        (secret key)
#   openssl rand -base64 24        (passwords)

# Lets plain `docker compose ...` use the production file without `-f`.
COMPOSE_FILE=docker-compose.prod.yml

# --- Images ------------------------------------------------------------------
# Where CI publishes the images (ghcr.io/<github-owner>/<repository>).
IMAGE_PREFIX=ghcr.io/kundlatsch/kamogawa-dashboard
# `latest` follows main. Pin a commit tag such as `sha-1a2b3c4` to freeze or roll back.
IMAGE_TAG=latest
# How often Watchtower checks GHCR for new images, in seconds.
WATCHTOWER_POLL_INTERVAL=300

# --- Network -----------------------------------------------------------------
# Host port where the app is served (http://<server-ip>:8088).
APP_PORT=8088
# Keep localhost and backend (used by the healthcheck and nginx); add the server's LAN IP,
# its Tailscale name, or the public domain of the Cloudflare Tunnel.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.0.10
# Full origins (scheme + host + port) the browser uses; needed for the Django admin.
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.0.10:8088

# --- Database ----------------------------------------------------------------
POSTGRES_DB=chacao
POSTGRES_USER=chacao
POSTGRES_PASSWORD=change-me

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
# Check-in deadlines and the Sunday 23:00 absences job use this time zone.
TZ=America/Sao_Paulo

# Account admin created on first boot (change the password in the app afterwards).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Optional services -------------------------------------------------------
# Comma-separated: `backup` (nightly database + uploads backup), `tunnel` (Cloudflare Tunnel).
# COMPOSE_PROFILES=backup
BACKUP_DIR=./backups
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14
# Token from the Cloudflare Zero Trust dashboard (only with the `tunnel` profile).
CLOUDFLARE_TUNNEL_TOKEN=
